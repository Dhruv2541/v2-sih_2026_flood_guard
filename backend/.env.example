# FloodGuard - Environment Configuration Example
# Copy this to .env and fill in your values
# NEVER commit actual credentials to Git

# ==========================================
# Database (Supabase PostgreSQL)
# ==========================================
# Format: postgresql://user:password@host:port/database
# Example: postgresql://postgres:password@db.xyz.supabase.co:5432/postgres
DATABASE_URL=

# ==========================================
# Application Settings
# ==========================================
ENVIRONMENT=development
API_PREFIX=/api/v1
PREDICTION_MODE=baseline
BASELINE_MODEL_VERSION=demo-baseline-v1
SCHEDULER_ENABLED=false
INGESTION_INTERVAL_MINUTES=60

# CORS - comma-separated or JSON array
# For local dev:
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
# For production, replace with your Vercel frontend URL:
# CORS_ORIGINS=["https://your-frontend.vercel.app"]

# ==========================================
# Open-Meteo Weather Provider
# ==========================================
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_TIMEOUT_SECONDS=10.0

# ==========================================
# Frontend (Vercel)
# ==========================================
# VITE_API_BASE_URL=https://your-backend.onrender.com