# Environment: development, staging, production
ENVIRONMENT=development

# API Versioning Prefix
API_PREFIX=/api/v1

# Supabase PostgreSQL Connection String
# Copy your connection URI from your Supabase Project Settings -> Database -> Connection string -> URI
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE

# Dedicated Isolated PostgreSQL Test Database (REQUIRED for running database integration tests)
# Must NEVER point to the production/development database.
DATABASE_URL_TEST=postgresql+psycopg://USER:PASSWORD@HOST:PORT/TEST_DATABASE

# CORS Allowed Origins (JSON array or comma-separated URLs)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Open-Meteo Weather Provider Configuration (Free tier for prototype, no API key required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_TIMEOUT_SECONDS=10.0

# Background Scheduler Configuration
# DEPLOYMENT INVARIANT: SCHEDULER_ENABLED=true MUST ONLY be used with a single FastAPI worker/process.
# Do NOT run with multiple Uvicorn/Gunicorn workers (e.g. uvicorn --workers 4).
SCHEDULER_ENABLED=false
# Configured default is 60 minutes. Adjusting this is an operational decision subject to provider rate limits.
INGESTION_INTERVAL_MINUTES=60
